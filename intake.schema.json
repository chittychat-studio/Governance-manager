{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governor/intake.schema.json",
  "title": "Governor intake (SPEC I1, I1a)",
  "type": "object",
  "required": ["app_type", "stack", "data_classes", "exposure", "tenancy", "agent", "test_cmd"],
  "additionalProperties": false,
  "properties": {
    "app_type": {"type": "string", "enum": ["api", "web-spa", "fullstack", "worker", "cli"]},
    "stack": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "data_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["none", "pii", "auth", "payments", "health"]}
    },
    "exposure": {"type": "string", "enum": ["public", "internal"]},
    "tenancy": {"type": "string", "enum": ["single", "multi"]},
    "agent": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["claude-code", "codex"]}
    },
    "test_cmd": {"type": "string", "minLength": 1},
    "integrations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "regulation": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pkg_mgr": {"type": "string", "enum": ["pip", "poetry", "uv", "npm", "pnpm", "yarn"]},
        "branch_rule": {"type": "string", "minLength": 1},
        "banned_libs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
